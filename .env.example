# Database Configuration
DATABASE_URL="file:./dev.db"

# Admin & Automation Secrets (Server-side only)
ADMIN_SECRET=""
CRON_SECRET=""

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://thebrief.in"

# AI Provider API Keys (Server-side only)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# AI Provider Configuration & Fallback Chain
# Supported providers: gemini | openai | anthropic | mock
# NOTE: The "mock" provider always sets reviewFlags.needsVerification = true,
# so mock-generated drafts are NEVER auto-published (they stay as DRAFT for
# manual review). Configure a real GEMINI_API_KEY/OPENAI_API_KEY/ANTHROPIC_API_KEY
# above for fully automatic hourly publishing to actually work end-to-end.
AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="mock"
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.1-flash-lite"
AI_ENABLED="true"

# Autonomous AI Newsroom Publishing Rules
# These control which AI-processed articles are auto-published with NO manual
# approval. Single-source stories ARE eligible (see calculatePublishConfidence
# in src/lib/ai/articleGenerationWorker.ts) as long as they clear these bars.
AUTO_PUBLISH_ENABLED="true"
AUTO_PUBLISH_MIN_CONFIDENCE="70"
AUTO_PUBLISH_MIN_QUALITY="65"
AUTO_PUBLISH_MIN_SOURCE_RELIABILITY="85"

# Hourly Ingestion Pipeline Tuning
# Only ingest articles published within this many hours (freshness window).
NEWS_LOOKBACK_HOURS="2"
# Caps on how many AI drafts are generated per cron run (cost/performance control).
NEWS_MAX_MULTI_SOURCE_DRAFTS_PER_RUN="5"
NEWS_MAX_SINGLE_SOURCE_DRAFTS_PER_RUN="15"
