generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id          String     @id @default(uuid())
  name        String
  type        String     @default("rss") // rss, api
  url         String
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  country     String?
  language    String?
  enabled     Boolean    @default(true)
  priority    Int        @default(1)
  lastFetch   DateTime?
  lastError   String?
  items       NewsItem[]
  logs        FetchLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  sources     Source[]
  items       NewsItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NewsItem {
  id            String    @id @default(uuid())
  sourceId      String
  source        Source    @relation(fields: [sourceId], references: [id])
  externalId    String?
  title         String
  description   String?
  originalUrl   String
  normalizedUrl String    @unique
  author        String?
  publishedAt   DateTime?
  discoveredAt  DateTime  @default(now())
  imageUrl      String?
  imageAlt      String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  status        String    @default("DISCOVERED") // DISCOVERED, REVIEW, APPROVED, PUBLISHED, REJECTED, ARCHIVED
  contentHash   String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([publishedAt])
  @@index([sourceId])
  @@index([categoryId])
  @@index([status])
}

model FetchLog {
  id           String   @id @default(uuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id])
  startedAt    DateTime
  completedAt  DateTime
  status       String   // SUCCESS, ERROR
  itemsFound   Int      @default(0)
  newItems     Int      @default(0)
  duplicates   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
}
