generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id          String     @id @default(uuid())
  name        String
  type        String     @default("rss") // rss, api
  url         String
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  country     String?
  language    String?
  enabled     Boolean    @default(true)
  priority    Int        @default(1)
  lastFetch            DateTime?
  lastSuccessfulFetch  DateTime?
  lastError            String?
  consecutiveFailures  Int        @default(0)
  items                NewsItem[]
  logs                 FetchLog[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Category {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  enabled        Boolean        @default(true)
  sources        Source[]
  items          NewsItem[]
  drafts         ArticleDraft[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model NewsItem {
  id            String         @id @default(uuid())
  sourceId      String
  source        Source         @relation(fields: [sourceId], references: [id])
  externalId    String?
  title         String
  description   String?
  originalUrl   String
  normalizedUrl String         @unique
  author        String?
  publishedAt   DateTime?
  discoveredAt  DateTime       @default(now())
  imageUrl      String?
  imageAlt      String?
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  status        String         @default("DISCOVERED") // DISCOVERED, REVIEW, APPROVED, PUBLISHED, REJECTED, ARCHIVED
  contentHash   String         @unique
  internalNotes String?
  checklist     String?        // JSON string of checklist items
  drafts        ArticleDraft[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([publishedAt])
  @@index([sourceId])
  @@index([categoryId])
  @@index([status])
}

model ArticleDraft {
  id               String    @id @default(uuid())
  newsItemId       String?
  newsItem         NewsItem? @relation(fields: [newsItemId], references: [id], onDelete: SetNull)
  title            String
  slug             String    @unique
  excerpt          String
  content          String
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorName       String    @default("THE BRIEF Editorial Team")
  authorId         String?
  featuredImage    String?
  imageAlt         String?
  status           String    @default("DRAFT") // DRAFT, REVIEW, APPROVED, PUBLISHED, ARCHIVED
  seoTitle         String?
  metaDescription  String?
  canonicalUrl     String?
  tags             String?   // JSON string of string[]
  sources          String?   // JSON string of { name: string, url: string }[]
  quickSummary     String?   // JSON string of string[]
  whatYouNeedToKnow String?  // JSON string of { whatHappened, whyItMatters, keyDetails, whatsNext }
  timeline         String?   // JSON string of { date, title, description }[]
  internalNotes    String?
  readingTime      Int       @default(3)
  featured         Boolean   @default(false)
  breaking         Boolean   @default(false)
  aiGenerated      Boolean   @default(false)
  aiProvider       String?
  aiModel          String?
  aiFlags          String?   // JSON string of { needsVerification: boolean, verificationNotes: string[] }
  generationLogs   AIGenerationLog[]
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([categoryId])
}

model AIGenerationLog {
  id           String        @id @default(uuid())
  operation    String        // draft_generation, headline, summary, seo, tags, rewrite, fact_check
  provider     String        // openai, gemini, anthropic, mock
  model        String
  newsItemId   String?
  draftId      String?
  draft        ArticleDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  durationMs   Int           @default(0)
  status       String        @default("SUCCESS") // SUCCESS, FAILED
  errorMessage String?
  reviewFlags  String?       // JSON string of verification flags
  user         String        @default("Admin Editor")
  createdAt    DateTime      @default(now())

  @@index([operation])
  @@index([provider])
  @@index([draftId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  user      String   @default("Admin Editor")
  action    String   // news_collected, news_reviewed, news_rejected, news_approved, draft_created, draft_updated, article_published, article_archived, source_toggled, ai_draft_generated, ai_improved
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FetchLog {
  id           String   @id @default(uuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id])
  startedAt    DateTime
  completedAt  DateTime
  status       String   // SUCCESS, ERROR
  itemsFound   Int      @default(0)
  newItems     Int      @default(0)
  duplicates   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
}

model CollectionJobLock {
  id         String   @id @default(uuid())
  jobName    String   @unique
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
}

model CollectionJob {
  id                String    @id @default(uuid())
  trigger           String    @default("cron") // cron, manual, cli, watch, webhook
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  status            String    @default("RUNNING") // RUNNING, COMPLETED, PARTIAL, FAILED, SKIPPED
  sourcesProcessed  Int       @default(0)
  successfulSources Int       @default(0)
  failedSources     Int       @default(0)
  itemsFound        Int       @default(0)
  itemsInserted     Int       @default(0)
  duplicates        Int       @default(0)
  errorCount        Int       @default(0)
  durationMs        Int       @default(0)
  errorMessage      String?
  sourceErrors      String?   // JSON string of { sourceId: string, sourceName: string, error: string }[]
  createdAt         DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}


